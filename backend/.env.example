# Copy to backend/.env and adjust. All values are optional; defaults shown.
APP_ENV=dev
DATABASE_URL=sqlite:///./autocare.db
# JSON list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=["http://localhost:5173"]
# Load and show the fictional demo mechanics (data/seed/mechanics.json).
# true for every environment in this course, including the final-demo production site.
# Set false only once real, assessed mechanics are listed: re-seeding then removes the demo ones.
DEMO_MODE=true

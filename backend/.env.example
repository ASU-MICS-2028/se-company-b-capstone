# Copy to backend/.env and adjust. All values are optional; defaults shown.
APP_ENV=dev
DATABASE_URL=sqlite:///./autocare.db
# JSON list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=["http://localhost:5173"]
# Token signing key. Required outside dev/test: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret
TOKEN_TTL_MINUTES=720
